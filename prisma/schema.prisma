// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================================================
// USER
// =========================================================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

// =========================================================
// SUBMISSION
// =========================================================

model Submission {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  altphone    String?
  state       String?
  district    String?
  village     String?
  pincode     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([state, district, village])
  @@index([pincode])
  @@index([email])
  @@index([name])
  @@index([createdAt(sort: Desc)])
  @@index([state])
  @@index([district])
  @@index([village])
  @@index([state, district])
  @@index([district, village])
  @@map("submissions")
}

// =========================================================
// EXISTING REGISTRATION
// =========================================================

model Registration {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  email       String?
  altPhone    String?
  state       String
  district    String
  village     String
  meetingInfo String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([state])
  @@index([district])
  @@map("registrations")
}

// =========================================================
// PRABHARI LEVEL
// =========================================================

enum PrabhariLevel {
  ZONE
  STATE
  SAMBHAG
  DISTRICT
  TEHSIL
}

// =========================================================
// ZONE
// =========================================================

model Zone {
  id   String @id @default(cuid())
  name String @unique

  states State[]

  prabhari Prabhari?
}

// =========================================================
// STATE
// =========================================================

model State {
  id   String @id @default(cuid())
  name String @unique

  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  sambhags  Sambhag[]
  districts District[]

  prabhari Prabhari?

  // Protest registration relation
  protestRegistrationMembers ProtestRegistrationMember[]
}

// =========================================================
// SAMBHAG
// =========================================================

model Sambhag {
  id   String @id @default(cuid())
  name String

  stateId String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  districts District[]

  prabhari Prabhari?

  @@unique([name, stateId])
}

// =========================================================
// DISTRICT
// =========================================================

model District {
  id   String @id @default(cuid())
  name String

  stateId String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  sambhagId String?
  sambhag   Sambhag? @relation(fields: [sambhagId], references: [id], onDelete: SetNull)

  tehsils   Tehsil[]
  prabharis Prabhari[]

  // Protest registration relation
  protestRegistrationMembers ProtestRegistrationMember[]

  @@unique([name, stateId])
}

// =========================================================
// TEHSIL
// =========================================================

model Tehsil {
  id   String @id @default(cuid())
  name String

  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  prabharis Prabhari[]

  // Protest registration relation
  protestRegistrationMembers ProtestRegistrationMember[]

  @@unique([name, districtId])
}

// =========================================================
// PRABHARI
// =========================================================

model Prabhari {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?

  level PrabhariLevel

  // Zone
  zoneId String? @unique
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  // State
  stateId String? @unique
  state   State?  @relation(fields: [stateId], references: [id], onDelete: SetNull)

  // Sambhag
  sambhagId String?  @unique
  sambhag   Sambhag? @relation(fields: [sambhagId], references: [id], onDelete: SetNull)

  // District
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  // Tehsil
  tehsilId String?
  tehsil   Tehsil? @relation(fields: [tehsilId], references: [id], onDelete: SetNull)

  @@index([districtId])
  @@index([tehsilId])
}

// =========================================================
// DOWNLOAD CARD
// =========================================================

model DownloadCard {
  id      String @id @default(cuid())
  titleEn String
  titleHi String

  pdfUrl   String? @db.Text
  cdrUrl   String? @db.Text
  imageUrl String? @db.Text
  audioUrl String? @db.Text

  mainIcon  String @default("FILE")
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  @@map("download_cards")
}

// =========================================================
// PROTEST REGISTRATION
// =========================================================
//
// One form submission can contain multiple members.
//
// Example:
//
// ProtestRegistration #10
//     ├── Person 1
//     ├── Person 2
//     └── Person 3
//
// =========================================================

model ProtestRegistration {
  id                   Int     @id @default(autoincrement())
  language             String
  wantsToAttendCapital Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ProtestRegistrationMember[]

  @@index([createdAt])
  @@index([language])
  @@index([wantsToAttendCapital])
  @@map("protest_registrations")
}

// =========================================================
// PROTEST REGISTRATION MEMBER
// =========================================================

model ProtestRegistrationMember {
  id Int @id @default(autoincrement())

  // Registration
  registrationId Int
  registration ProtestRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Person
  name String
  phone String

  // State
  stateId String
  state State @relation(fields: [stateId], references: [id], onDelete: Restrict)

  // District
  districtId String
  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  // Tehsil
  tehsilId String
  tehsil Tehsil @relation(fields: [tehsilId], references: [id], onDelete: Restrict)

  // Village
  village String

  // Timestamp
  createdAt DateTime @default(now())

  // Indexes
  @@index([registrationId])
  @@index([phone])
  @@index([name])
  @@index([stateId])
  @@index([districtId])
  @@index([tehsilId])
  @@index([village])
  @@index([stateId, districtId])
  @@index([stateId, districtId, tehsilId])
  @@index([createdAt])

  @@map("protest_registration_members")
}